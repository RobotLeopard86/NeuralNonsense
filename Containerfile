FROM fedora:latest

# Create application directory
RUN mkdir -p /opt/neuralnonsense

# Copy the self-contained production build
# This assumes the dist folder has been generated by dist.sh on the host
COPY dist/ /opt/neuralnonsense/

# Ensure the startup script is executable
RUN chmod +x /opt/neuralnonsense/run.sh

# Install packages
RUN dnf install libicu -y --best

# Expose HTTPS port
EXPOSE 443

# Set the working directory so run.sh can find its relative paths
WORKDIR /opt/neuralnonsense

# Start the server directly as PID 1
# Using the shell form or a direct call ensures that if run.sh exits,
# the container exits, triggering the container engine's restart policy.
ENTRYPOINT ["/opt/neuralnonsense/run.sh"]
